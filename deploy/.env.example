# Optional — prefer first-run UI at http://127.0.0.1:8080/setup.html
# (writes /data/t9.setup.json and optional /data/cloudflare.token)
# T9_DB_KEY=
# T9_BASE_URL=
T9_PORT=8080
# If you rotated the seal key and cannot decrypt, set once then remove:
# T9_RESET_DB=1
