# Copy to deploy/.env and fill in secrets. deploy/.env is gitignored — never commit it.

# Required for public HTTPS via Cloudflare Tunnel (https://t9.snrt.tech)
CLOUDFLARE_TUNNEL_TOKEN=

# Public origin advertised to clients / release URLs (must match the Cloudflare hostname)
T9_BASE_URL=https://t9.snrt.tech

# ≥16 chars. Prefer setting here for tunnel-first boot (skips interactive setup UI).
# Or use docker-compose.local.yml once and open http://127.0.0.1:8080/setup.html
# T9_DB_KEY=

# If you rotated the seal key and cannot decrypt, set once then remove:
# T9_RESET_DB=1

# Optional APNs (remote push when app is backgrounded):
# T9_APNS_KEY_ID=
# T9_APNS_TEAM_ID=
# T9_APNS_KEY_PATH=/run/secrets/AuthKey.p8
# T9_APNS_BUNDLE_ID=app.t9.messenger
# T9_APNS_PRODUCTION=0

# Cloudflare Turnstile on account create (recommended when internet-facing):
# T9_TURNSTILE_SITE_KEY=
# T9_TURNSTILE_SECRET=

# Per-source rate limits are on by default; set to 1 only to disable:
# T9_RATE_LIMIT_DISABLED=0

# Only used with docker-compose.local.yml (loopback publish on the Docker host):
# T9_LOCAL_PORT=8080
